# TMDB account Settings > API > API Read Access Token (not your password).
TMDB_READ_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=7000
# Required for personal TMDB credentials. Generate once: openssl rand -hex 32
# Keep private and unchanged across restarts/replicas; changing it invalidates install links.
CONFIG_SECRET=

# Optional: show a support card after creating your Ko-fi account.
# Example: https://ko-fi.com/yourname. Leave blank to hide the card.
KO_FI_URL=

# Optional operator settings; see README "Operator settings". Defaults shown.
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_CONCURRENCY=4
# TMDB_QUEUE_LIMIT=500
# TMDB_CACHE_ENTRIES=1000
# TMDB_PERSONAL_CACHE_ENTRIES=100
# PERSONAL_CLIENT_LIMIT=50
# SEARCH_MAX_PAGES=5
# SETUP_RATE_LIMIT=30
# SETUP_CONCURRENCY=4
# REQUEST_TIMEOUT_MS=30000
# LOGO_URL=https://your-host.example/logo.png
